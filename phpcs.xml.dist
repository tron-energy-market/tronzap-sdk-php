<?xml version="1.0"?>
<ruleset name="TronZap SDK">
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
